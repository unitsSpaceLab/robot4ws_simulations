<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot4ws_simulations</name>
  <version>2.0.0</version>
  <description>The robot4ws_simulations package for ROS2 Humble and Gazebo Harmonic</description>
  <maintainer email="khalid.bourr@gmail.com">KHALID BOURR</maintainer>
  <license>GPLv3</license>
  <url type="website">http://wiki.ros.org/robot4ws_simulations</url>
  <author email="khalid.bourr@gmail.com">KHALID BOURR</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot4ws_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>